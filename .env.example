# --- AI keys (set the one you use; with both, the other is the fallback) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Or a custom gateway (e.g. LiteLLM) that serves both; set both lines. The keys above win over it.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=                      # e.g. https://litellm.rstuff.in
# ELEVENLABS_API_KEY=                 # only for voice: elevenlabs

# --- Or a local / open-weight AI (ai: local, and model: in the product file) ---
# APP_STORY_AI_BASE_URL=http://localhost:11434/v1   # Ollama; LM Studio: http://localhost:1234/v1; vLLM: http://localhost:8000/v1
# APP_STORY_AI_API_KEY=                             # only if the server wants one

# --- Passwords a product file reads with env:NAME, e.g. login: demo@acme.com / env:ACME_PASSWORD ---
# ACME_PASSWORD=

# --- Voice (all products) ---
# APP_STORY_VOICE=female                # female | male | a voice name (Kokoro: am_puck, bf_emma, ...) | a WAV to copy (Chatterbox)
# APP_STORY_PYTHON=python               # the Python with chatterbox-tts installed (voice: chatterbox)
# APP_STORY_VOICE_ACCENT=american       # american | british (Kokoro)
# APP_STORY_VOICE_SPEED=1.0             # 0.7 (slower) to 1.3 (faster)
# APP_STORY_VOICE_TONE=warm and upbeat  # OpenAI voice; Chatterbox only knows "expressive"
# APP_STORY_AI_REVIEW=on                # off skips the AI's look at the finished video (it re-frames missed shots)
# APP_STORY_BLOG=on                     # off makes videos without a blog post (.blog.md and its screenshots)
# APP_STORY_WORD_TIMING=on              # off skips timing each spoken word (captions are then timed by length)
# APP_STORY_KOKORO_DTYPE=fp32           # fp32 (clearest, default) | fp16 | q8 | q4 | q4f16 (smaller, faster, a little buzzy)

# --- Optional (these win over the product file) ---
# APP_STORY_AI_PROVIDER=anthropic     # anthropic | openai | local
# APP_STORY_AI_MODEL=claude-opus-5-5
# APP_STORY_TTS_PROVIDER=kokoro       # kokoro | chatterbox | openai | elevenlabs | none
# APP_STORY_AI_EFFORT=high            # low | medium | high | xhigh | max (default: set per step)
# APP_STORY_HOME=/path/to/project     # your project folder (set it in the shell, not here); found by itself otherwise
# APP_STORY_LOG_LEVEL=info            # debug | info | warn | error | silent
# APP_STORY_RENDER_WORKERS=4          # render workers, each its own headless browser (default: half the CPU cores, up to 8)
# APP_STORY_RENDER_CACHE_MB=2048      # drawn video chunks kept for re-renders (redo, the AI review); 0 turns it off
