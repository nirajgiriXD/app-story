# Copy this file to .env and fill in what you need. Never commit .env.

# --- AI providers (set the one(s) you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Text-to-speech ---
# ElevenLabs is used when providers.tts.provider = elevenlabs.
# OpenAI TTS reuses OPENAI_API_KEY.
ELEVENLABS_API_KEY=

# --- Optional overrides (CLI flags win over these, these win over product.yaml) ---
# DEMOFORGE_AI_PROVIDER=anthropic
# DEMOFORGE_AI_MODEL=claude-opus-5-5
# DEMOFORGE_TTS_PROVIDER=openai
# DEMOFORGE_PRODUCTS_DIR=./products
# DEMOFORGE_OUTPUT_DIR=./output
# DEMOFORGE_LOG_LEVEL=info

# --- Example product (examples/projects-app) login ---
EXAMPLE_APP_USER=demo@example.com
EXAMPLE_APP_PASSWORD=demo1234
