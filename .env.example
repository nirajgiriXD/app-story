# --- AI keys (set the one you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Passwords a product file reads with env:NAME, e.g. login: demo@acme.com / env:ACME_PASSWORD ---
# ACME_PASSWORD=

# --- Voice (all products) ---
# DEMOFORGE_VOICE=female              # female | male | a voice name (Kokoro: am_puck, bf_emma, ...)
# DEMOFORGE_VOICE_ACCENT=american     # american | british (Kokoro)
# DEMOFORGE_VOICE_SPEED=1.0           # 0.7 (slower) to 1.3 (faster)
# DEMOFORGE_VOICE_TONE=warm and upbeat  # OpenAI voice only

# --- Optional (these win over the product file) ---
# DEMOFORGE_AI_PROVIDER=anthropic     # anthropic | openai
# DEMOFORGE_AI_MODEL=claude-opus-5-5
# DEMOFORGE_LOG_LEVEL=info            # debug | info | warn | error | silent
