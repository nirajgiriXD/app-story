# --- AI keys (set the one you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Passwords a product file reads with env:NAME, e.g. login: demo@acme.com / env:ACME_PASSWORD ---
# ACME_PASSWORD=

# --- Voice (all products) ---
# APP_STORY_VOICE=female                # female | male | a voice name (Kokoro: am_puck, bf_emma, ...)
# APP_STORY_VOICE_ACCENT=american       # american | british (Kokoro)
# APP_STORY_VOICE_SPEED=1.0             # 0.7 (slower) to 1.3 (faster)
# APP_STORY_VOICE_TONE=warm and upbeat  # OpenAI voice only
# APP_STORY_WORD_TIMING=on              # off skips timing each spoken word (captions are then timed by length)
# APP_STORY_KOKORO_DTYPE=fp32           # fp32 (clearest, default) | fp16 | q8 (smaller, faster, a little buzzy)

# --- Optional (these win over the product file) ---
# APP_STORY_AI_PROVIDER=anthropic     # anthropic | openai
# APP_STORY_AI_MODEL=claude-opus-5-5
# APP_STORY_AI_EFFORT=high            # low | medium | high | xhigh | max (default: set per step)
# APP_STORY_HOME=/path/to/project     # your project folder (set it in the shell, not here); found by itself otherwise
# APP_STORY_LOG_LEVEL=info            # debug | info | warn | error | silent
# APP_STORY_RENDER_WORKERS=4          # frames drawn at once while rendering (default: half the CPU cores, up to 8)
