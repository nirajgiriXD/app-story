{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // npm writes the lockfile itself. Markdown is left alone: it holds AI prompts and product files.
  "files": { "ignoreUnknown": true, "includes": ["**", "!package-lock.json", "!**/*.md"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // The code uses `!` where an index is known to exist (noUncheckedIndexedAccess is on).
        "noNonNullAssertion": "off"
      },
      "performance": {
        // innerText is the visible text, which is what a demo needs; textContent is not the same.
        "useDomNodeTextContent": "off"
      }
    }
  }
}
