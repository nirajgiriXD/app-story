{
  "name": "app-story-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "engine/cli",
    "engine/packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "app-story": "tsx engine/cli/src/index.ts",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node engine/scripts/vitest.mjs run --project unit",
    "test:integration": "node engine/scripts/vitest.mjs run --project integration",
    "test:e2e": "node engine/scripts/vitest.mjs run --project e2e",
    "test:all": "node engine/scripts/vitest.mjs run",
    "example-app": "node engine/data/example-app/server.mjs",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@app-story/ai": "*",
    "@app-story/browser": "*",
    "@app-story/captions": "*",
    "@app-story/cli": "*",
    "@app-story/contracts": "*",
    "@app-story/core": "*",
    "@app-story/narration": "*",
    "@app-story/products": "*",
    "@app-story/shared": "*",
    "@app-story/video": "*",
    "@app-story/workflow": "*",
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "dotenv": "^18.0.10",
    "openai": "^7.57.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": false,
    "sharp": false,
    "protobufjs": false
  }
}
