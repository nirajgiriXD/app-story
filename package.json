{
  "name": "demoforge-monorepo",
  "private": true,
  "workspaces": [
    "engine/cli",
    "engine/packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "demoforge": "tsx engine/cli/src/index.ts",
    "typecheck": "tsc -p engine/tsconfig.json --noEmit",
    "test": "node engine/scripts/vitest.mjs run --project unit",
    "test:integration": "node engine/scripts/vitest.mjs run --project integration",
    "test:e2e": "node engine/scripts/vitest.mjs run --project e2e",
    "test:all": "node engine/scripts/vitest.mjs run",
    "example-app": "node engine/data/example-app/server.mjs",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@demoforge/ai": "*",
    "@demoforge/browser": "*",
    "@demoforge/captions": "*",
    "@demoforge/cli": "*",
    "@demoforge/contracts": "*",
    "@demoforge/core": "*",
    "@demoforge/narration": "*",
    "@demoforge/products": "*",
    "@demoforge/shared": "*",
    "@demoforge/video": "*",
    "@demoforge/workflow": "*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "dotenv": "^18.0.10",
    "openai": "^7.57.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true,
    "onnxruntime-node": false,
    "sharp": false,
    "protobufjs": false
  }
}
